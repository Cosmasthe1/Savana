NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://savana:savana@localhost:5432/savana
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
CORS_ORIGINS=http://localhost:5173
# S3-compatible storage (MinIO locally; S3 or R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=savana-media
S3_ACCESS_KEY=savana
S3_SECRET_KEY=savanasecret
S3_FORCE_PATH_STYLE=true
# Base URL that serves objects under pub/ (CDN in production)
PUBLIC_MEDIA_URL=http://localhost:9000/savana-media
MAX_UPLOAD_BYTES=5368709120
